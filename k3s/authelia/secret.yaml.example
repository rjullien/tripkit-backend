# ⚠️ Copy to secret.yaml, fill values, DO NOT commit!
# Generate secrets with: openssl rand -hex 64
apiVersion: v1
kind: Secret
metadata:
  name: authelia-secrets
  namespace: authelia
type: Opaque
stringData:
  storage-encryption-key: "CHANGE_ME_openssl_rand_hex_64"
  session-secret: "CHANGE_ME_openssl_rand_hex_64"
  jwt-secret: "CHANGE_ME_openssl_rand_hex_64"
