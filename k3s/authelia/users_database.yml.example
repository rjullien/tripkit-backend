# Authelia Users Database
# Generate password hashes with:
#   docker run --rm authelia/authelia:latest authelia crypto hash generate argon2 --password 'your-password'
#
# After first login, users can set up WebAuthn (passkeys/Face ID) for passwordless auth.
---
users:
  rene:
    disabled: false
    displayname: René
    # Replace with real hash — generate with command above
    password: "$argon2id$v=19$m=65536,t=3,p=4$CHANGE_ME"
    email: rene.jullien@gmail.com
    groups:
      - family
      - admin

  baptiste:
    disabled: false
    displayname: Baptiste
    password: "$argon2id$v=19$m=65536,t=3,p=4$CHANGE_ME"
    email: baptiste.jullien06@gmail.com
    groups:
      - family
      - admin

  nicole:
    disabled: false
    displayname: Nicole
    password: "$argon2id$v=19$m=65536,t=3,p=4$CHANGE_ME"
    email: nicol.jullien@gmail.com
    groups:
      - family

  alexandre:
    disabled: false
    displayname: Alexandre
    password: "$argon2id$v=19$m=65536,t=3,p=4$CHANGE_ME"
    email: alexandre.jullien06@gmail.com
    groups:
      - family

  camille:
    disabled: false
