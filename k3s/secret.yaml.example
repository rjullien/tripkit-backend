# ⚠️ Copy to secret.yaml, fill values, DO NOT commit!
#
# Generate each value with: openssl rand -hex 32
#   api-token   — static admin Bearer token (full access)
#   jwt-secret  — HMAC signing key for magic-link JWTs (REQUIRED in production;
#                 the server refuses to start without it when TRIPKIT_ENV!=dev)
apiVersion: v1
kind: Secret
metadata:
  name: tripkit-secrets
  namespace: tripkit
type: Opaque
stringData:
  api-token: "CHANGE_ME_openssl_rand_hex_32"
  jwt-secret: "CHANGE_ME_openssl_rand_hex_32"
