# ⚠️ Copy to secret.yaml, fill values, DO NOT commit!
apiVersion: v1
kind: Secret
metadata:
  name: tripkit-secrets
  namespace: tripkit
type: Opaque
stringData:
  # Token admin historique (accès total, ne pas donner à un contributeur externe)
  api-token: "CHANGE_ME_openssl_rand_hex_32"
  # Clé de signature des liens magiques
  jwt-secret: "CHANGE_ME_openssl_rand_hex_32"
  # Tokens de service non-admin, format "user1:token1,user2:token2"
  # 1 token = 1 utilisateur soumis au ACL groupes (openssl rand -hex 32)
  service-tokens: "nadia:CHANGE_ME_openssl_rand_hex_32"
